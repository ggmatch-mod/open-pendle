{
  "name": "openpendle",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:alerts": "node --experimental-strip-types scripts/alerts-check.mjs",
    "check:action-center": "node --experimental-strip-types scripts/action-center-check.mjs",
    "check:boros-hedge": "node --experimental-strip-types scripts/boros-hedge-check.mjs",
    "check:deployment-safety": "node --experimental-strip-types scripts/deployment-safety-check.mjs",
    "check:oracle-sy": "node --experimental-strip-types scripts/oracle-sy-check.mjs",
    "build:oracle-sy": "node scripts/build-oracle-sy.mjs",
    "check:oracle-sy-artifact": "node scripts/build-oracle-sy.mjs --check",
    "test:oracle-sy-contracts": "forge test --root ../contracts/oracle-sy",
    "test:oracle-sy-fork": "ORACLE_SY_FORK_RPC_URL=${ORACLE_SY_FORK_RPC_URL:-https://base.publicnode.com} forge test --root ../contracts/oracle-sy --match-contract PendleCompatibilityTest --evm-version cancun",
    "check:limit-orders": "node --experimental-strip-types scripts/limit-order-check.mjs",
    "check:looping": "node --experimental-strip-types scripts/looping-check.mjs",
    "check:looping-adjustment-math": "node --experimental-strip-types scripts/looping-adjustment-math-check.mjs",
    "check:looping-execution": "node --experimental-strip-types scripts/looping-execution-check.mjs",
    "check:looping-fork-harness": "node --experimental-strip-types scripts/looping-fork-harness-check.mjs",
    "check:looping-pending": "node --experimental-strip-types scripts/looping-pending-check.mjs",
    "check:looping-rpc-beta": "node --experimental-strip-types scripts/looping-rpc-beta-check.mjs",
    "check:looping-mint-runtime-policy": "node --experimental-strip-types scripts/looping-mint-runtime-policy-check.mjs",
    "audit:looping-mint-live": "node --experimental-strip-types scripts/looping-mint-live-audit.mjs",
    "check:looping-ui-safety": "node scripts/looping-ui-safety-check.mjs",
    "check:looping-live-canary": "node --experimental-strip-types scripts/looping-live-canary-safety-check.mjs",
    "check:looping-markets": "node --experimental-strip-types scripts/looping-market-manifest-check.mjs",
    "test:looping-fork": "npm run test:looping-fork:arbitrum-maturity",
    "test:looping-fork:arbitrum-maturity": "node --experimental-strip-types scripts/looping-maturity-fork.mjs",
    "test:looping-fork:ethereum": "node --experimental-strip-types ../fork-tests/scripts/run-looping-fork.mjs --chain ethereum --compiler-only --initial-usdc 1 --loop-usdc 0.5",
    "test:looping-fork:mint:ethereum": "node --experimental-strip-types ../fork-tests/scripts/run-looping-fork.mjs --chain ethereum --compiler-only --mode mint --initial-usdc 1 --loop-usdc 0.5",
    "test:looping-fork:mint:monad": "node --experimental-strip-types ../fork-tests/scripts/run-looping-fork.mjs --chain monad --compiler-only --mode mint --initial-usdc 1 --loop-usdc 0.5",
    "test:looping-fork:monad": "node --experimental-strip-types ../fork-tests/scripts/run-looping-fork.mjs --chain monad --compiler-only --initial-usdc 1 --loop-usdc 0.5",
    "check:startup": "node --experimental-strip-types scripts/startup-recovery-check.mjs",
    "check:wallet-storage": "node --experimental-strip-types scripts/wagmi-storage-check.mjs",
    "check:catalog": "node --experimental-strip-types scripts/catalog-check.mjs",
    "check:factory-markets": "node --experimental-strip-types scripts/index-factory-markets.mjs --check",
    "check:factory-markets:complete": "node --experimental-strip-types scripts/index-factory-markets.mjs --check --require-complete",
    "check:factory-markets:fresh": "node --experimental-strip-types scripts/index-factory-markets.mjs --check --require-complete --max-age-seconds 172800",
    "check:m12": "node --experimental-strip-types scripts/m12-token-check.mjs",
    "check:positions": "node --experimental-strip-types scripts/positions-check.mjs",
    "check:portfolio": "node --experimental-strip-types scripts/portfolio-check.mjs",
    "check:portfolio-positions": "node --experimental-strip-types scripts/portfolio-positions-check.mjs",
    "index:factory-markets": "node --experimental-strip-types scripts/index-factory-markets.mjs",
    "preview": "vite preview",
    "sweep": "node --experimental-strip-types scripts/sweep.mjs"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "viem": "^2.54.2",
    "wagmi": "2.19.5"
  },
  "overrides": {
    "ws@8": "^8.22.0",
    "uuid@<11.1.1": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
