  "sourceChanges": {
    "PendleSwap.sol": "Adds ZEROX=7 branch with output balance delta and scaled minimum check; removes ODOS scaling; Kyber branch and infinite approvals to extRouter unchanged.",
    "IPSwapAggregator.sol": "KYBERSWAP stays enum1; retired ODOS enum2 becomes RESERVED1; ZEROX added at7.",
    "TokenHelper.sol": "Transfer-out skips self-transfers; balance lookup moved to shared _balanceOf. No state added.",
    "OKXScaleHelper.sol": "Adds chain approval targets; only immutable state. Kyber never takes this branch.",
    "OpenZeppelin": "All verified imported OpenZeppelin source files unchanged from pinned implementation."
  },
